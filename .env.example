PROJECT_NAME=TechCart
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000

# ── MONGODB ─────────────────────────────────────────────
# Stores conversations + embedded messages (Task 1)
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_ROOT_USER=techcart_user
MONGO_ROOT_PASSWORD=techcart_secret_2024
MONGO_DB=techcart

MONGODB_URL=mongodb://techcart_user:techcart_secret_2024@mongodb:27017/techcart?authSource=admin
MONGODB_DB=techcart

# ── QDRANT ──────────────────────────────────────────────
# Stores vector embeddings (replaces ChromaDB)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=techcart_products

# ── OLLAMA ──────────────────────────────────────────────
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=mistral:latest
EMBEDDING_MODEL=BAAI/bge-m3

# ── RAG SETTINGS ────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=100
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7

# ── POSTGRESQL (DISABLED — kept for when SQL search returns) ──
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=techcart
# POSTGRES_USER=techcart_user
# POSTGRES_PASSWORD=techcart_secret_2024
# DATABASE_URL=postgresql+asyncpg://techcart_user:techcart_secret_2024@postgres:5432/techcart