
PROJECT_NAME=TechCart
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ─────────────────────────────────────────────
# MONGODB
# ─────────────────────────────────────────────
MONGO_ROOT_USER=techcart_user
MONGO_ROOT_PASSWORD=techcart_secret_2024
MONGO_DB=techcart
MONGODB_URL=mongodb://techcart_user:techcart_secret_2024@mongodb:27017/techcart?authSource=admin
MONGODB_DB=techcart

# ─────────────────────────────────────────────
# QDRANT
# ─────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=techcart_bge_m3

# ─────────────────────────────────────────────
# OLLAMA
# ─────────────────────────────────────────────
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=mistral:latest
EMBEDDING_MODEL=bge-m3

# ─────────────────────────────────────────────
# RERANKER — Qwen3 Reranker served by Ollama
# ─────────────────────────────────────────────
RERANKER_ENABLED=true
RERANKER_PROVIDER=ollama
RERANKER_MODEL=dengcao/Qwen3-Reranker-0.6B:Q8_0
RERANKER_TIMEOUT_SECONDS=30
RERANKER_TOP_LOGPROBS=20
RERANKER_INSTRUCTION="Given a web search query, retrieve relevant passages that answer the query"
RERANKER_MAX_DOCUMENT_CHARS=12000

# ─────────────────────────────────────────────
# RETRIEVAL
# ─────────────────────────────────────────────
RETRIEVAL_K=10
TOP_K_RESULTS=5
RETRIEVAL_TIMEOUT_SECONDS=180
SIMILARITY_THRESHOLD=0.0

# ─────────────────────────────────────────────
# POSTGRESQL
# DISABLED — reserved for future SQL search
# ─────────────────────────────────────────────
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=techcart
# POSTGRES_USER=techcart_user
# POSTGRES_PASSWORD=techcart_secret_2024
# DATABASE_URL=postgresql+asyncpg://techcart_user:techcart_secret_2024@postgres:5432/techcart
